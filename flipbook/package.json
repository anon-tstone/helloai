{
  "name": "flipbook-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Flipbook Studio \u2014 Canva-class page/graphic editor with Cloudflare backend and offline export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty",
    "db:local": "wrangler d1 execute flipbook-studio --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute flipbook-studio --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.130.0"
  }
}
